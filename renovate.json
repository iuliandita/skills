{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "timezone": "Etc/UTC",
  "schedule": [
    "* 0-11 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/tools/semgrep/requirements\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "zizmor binary version passed to zizmor-action; scripts/test-report-tool-pins.sh asserts this pattern against security.yml",
      "managerFilePatterns": [
        "/^\\.github/workflows/security\\.yml$/"
      ],
      "matchStrings": [
        "uses: zizmorcore/zizmor-action@[^\\n]*\\n\\s+with:\\n\\s+version: \"(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "description": "requirements.txt is a pip-compile lockfile: the pip-compile manager bumps requirements.in and regenerates the hashes, so pip_requirements must not edit single pins in it",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".github/tools/semgrep/**"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        ".github/tools/semgrep/**"
      ],
      "groupName": "semgrep",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "zizmorcore/zizmor"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/tools/markdownlint/**"
      ],
      "groupName": "markdownlint",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "description": "the docker skill's Node example builds on node:NN-slim and runs on distroless nodejsNN; the runtime major is part of the image name, which a tag bump cannot change, so a node major alone would split the two stages",
      "matchFileNames": [
        "skills/docker/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
